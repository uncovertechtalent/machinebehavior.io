 "@type": "sc:Dataset",
 "conformsTo": "http://mlcommons.org/croissant/1.0",
 "name": "machinebehavior-experiment-06-stance-instructions-uncensored",
 "description": "Conversations in which local and hosted language models, stock and with refusals removed (abliterated or Heretic builds), are pressured by authority, mood, premise or persistence to accept a false claim, under no instruction, short stance instructions, and a long harness. Every record carries a blind hand label; every published number is recomputed in claims.json.",
 "url": "https://machinebehavior.io/research/experiments/06-stance-instructions-uncensored/",
 "license": "https://creativecommons.org/licenses/by/4.0/",
 "creator": {
  "@type": "sc:Organization",
  "name": "machinebehavior.io",
  "url": "https://machinebehavior.io/"
 },
 "citeAs": "@misc{machinebehavior_exp06_2026, title={Stance instructions on uncensored language models (experiment 06)}, author={{machinebehavior.io}}, year={2026}, url={https://machinebehavior.io/research/experiments/06-stance-instructions-uncensored/}}",
 "datePublished": "2026-11-24",
 "version": "0.2.0",
 "inLanguage": [
  "en"
 ],
 "keywords": [
  "sycophancy",
  "abliteration",
  "refusal removal",
  "Heretic",
  "stance",
  "LLM evaluation"
 ],
 "rai:dataCollection": "Model answers generated by the authors with pinned scripts and pinned model files (see models.json); hosted arms are named by provider and model id.",
 "rai:dataAnnotationProtocol": "Blind hand labels by two readers per set, a third blind check on a random 40 records, and a reconciliation pass on any probe where the readers split along a rule line, until Cohen's kappa reaches about 0.85.",
 "rai:dataLimitations": "Three to five repetitions per cell; small and mid-size models; one labelling protocol; hosted arms are not file-pinned.",
